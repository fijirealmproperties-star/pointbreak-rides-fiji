# Production deployment settings. Copy to .env, fill in, never commit.
# Generate JWT secrets + an admin password with: node scripts/gen-secrets.js

# Domain Caddy serves (auto HTTPS). Use http://1.2.3.4 for HTTP-only testing.
SITE_DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# Required: at least 32 random characters each, and they must differ.
JWT_SECRET=
JWT_REFRESH_SECRET=

# First admin account (created only when the database has no users).
ADMIN_PHONE=+6790000000
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Browser origins allowed to call the API (comma-separated).
# Native apps send no Origin and are always allowed.
CORS_ORIGINS=https://app.example.com

# Keep demo accounts/known passwords out of production.
SEED_DEMO=false
DEMO_MODE=false

# Map services. Routing (OSRM) and reverse geocoding (Nominatim) run as free
# self-hosted containers in this stack — prepare their data once with
# scripts/prepare-fiji-maps.sh, then start the "maps" profile:
#   docker compose --profile maps up -d --build
# The values below are the in-network service addresses.
# Comment both out if you are not running the maps profile.
OSRM_URL=http://osrm:5000
NOMINATIM_URL=http://nominatim:8080
CONTACT_EMAIL=

# Optional: MapTiler key. Only needed if you deliberately use MapTiler instead
# of the self-hosted Nominatim above (their free tier is non-commercial).
# MAPTILER_KEY=

# Optional: basemap style for the built web app. Default is OpenFreeMap
# (free, keyless): https://tiles.openfreemap.org/styles/liberty
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Set if you never run behind a reverse proxy (rate limiting then uses the
# socket address instead of X-Forwarded-For).
# TRUST_PROXY=false
