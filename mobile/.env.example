# Copy to .env for local development, or set these in EAS (eas env:create).
# Expo inlines EXPO_PUBLIC_* values at bundle time.

# API origin. Required for store builds (must be HTTPS).
# Leave unset on web dev: the app auto-targets <page-host>:3003,
# and same-origin when served over HTTPS in production.
# For a physical phone on your LAN, use http://192.168.0.35:3003
# EXPO_PUBLIC_API_URL=https://api.pointbreakrides.com

# Set to "false" to hide demo accounts and prefilled logins.
# EXPO_PUBLIC_DEMO=true

# Basemap style (vector, rendered by MapLibre GL inside Leaflet). The default is
# OpenFreeMap — free, keyless, no request limits: https://openfreemap.org
# Other built-in OpenFreeMap styles: positron, bright, liberty, dark, fiord.
# EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
#
# Self-hosted style (PMTiles / your own tile server) also works — just point the
# URL at its style JSON.
#
# Raster fallback instead of vector: set EXPO_PUBLIC_MAP_STYLE_URL=raster, then
# provide a licensed XYZ template below (must include {z}/{x}/{y}).
# EXPO_PUBLIC_MAP_STYLE_URL=raster
# EXPO_PUBLIC_TILE_URL_TEMPLATE=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# EXPO_PUBLIC_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
